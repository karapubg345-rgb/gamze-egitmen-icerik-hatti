# Anahtarlar
.env

# Paketler ve çıktılar (yeniden üretilebilir)
node_modules/
**/out/
.playwright-mcp/
__pycache__/

# Büyük medya — videolar yerelde kalır
video-*/klipler/*.mp4
video-*/klipler/*.wav
video-*/teslim/*.mp4
video-*/kurgu/public/
video-*/ses/*.webm
video-*/kareler/v*/

# Başkalarına ait referans fotoğraflar (telif) — yalnız REFERANS-KARTI.md paylaşılır
video-*/gercek-referans/indirilen/
video-*/gercek-referans/secilen/

# Eski denemeler
_eski/

# Gamze'nin ham çekimleri (büyük dosya, yerelde kalır)
referans-videolar/*.mp4

# Gamze'nin çekiminden kesilen kaynaklar ve analiz kareleri (özel görüntü, yerelde kalır)
video-*/kaynak/
video-*/klipler/*.jpg
video-*/klipler/*.png
referans-videolar/*.jpg
video-*/kareler/genis-*/
video-*/ses/*-taslak.mp3
video-*/gercek-referans/*.jpg

# Arayüz çalışma günlükleri ve durum
video-*/.arayuz/

# Kurulum doğrulama çıktıları
ornekler/cikti/
