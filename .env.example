# Bu dosyayı .env olarak kopyalayıp doldurun. .env GitHub'a gönderilmez.

# Playwright Chrome uzantısının bağlantı anahtarı (uzantı → "Copy token")
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# Gerçek referans araması (biri yeterli; hiçbiri yoksa Bing Görseller tarayıcıdan kullanılır)
SERPER_API_KEY=        # serper.dev — Google Görseller, 2.500 ücretsiz sorgu
PIXABAY_API_KEY=       # pixabay.com/api/docs — ücretsiz

# Seslendirme
# Ses ElevenLabs MCP ile üretilir (claude → /mcp → elevenlabs → Authenticate); anahtar gerekmez.
# Ortak ayar: buradaki değer /guncelle sonrası açılışta .env'e kendiliğinden yazılır (elle değiştirmeyin).
ELEVENLABS_VOICE_ID=Xen0soH4tcGo78ododZU
# Gamze Hoca'nın kendi ses klonu (ElevenLabs → Voices → klonun kimliği). Yalnız üretim bilgisayarının .env'inde doldurulur;
# doluysa açılışta ELEVENLABS_VOICE_ID'nin yerine geçer ve her seslendirme klonla yapılır. Boşsa yukarıdaki ortak ses kullanılır.
HOCA_SES_ID=

# Telegram botu (telefondan başlatma ve onay) — KURULUM.md 6. adım
TELEGRAM_BOT_TOKEN=    # @BotFather → /newbot
TELEGRAM_CHAT_ID=      # boş bırakıp bota yazın, kimliğinizi söyler; birden çok kişi için virgülle

# Telegram video linki: önce yt-dlp (ücretsiz, kurulum gerekmez). Instagram yt-dlp ile inmezse Apify (apify.com → Settings → API tokens; aylık ücretsiz kota var)
APIFY_TOKEN=

# Yeni videoların varsayılanları (Telegram'da "kredili"/"onaylı" yazılmazsa bunlar geçerli)
VARSAYILAN_MOD=kredisiz   # kredisiz | kredili
VARSAYILAN_ONAY=yok       # yok = tam otomatik (Claude karar verir) | iki = kareler ve teslimde sor
ESIK_UYUM=70             # bu yüzdenin üstündeki sonuç düzeltilmeden teslim edilir, eksikler listelenir
TAKILMA_DK=90            # kredisizde kareler/video bu kadar dakikadan uzun sürerse Telegram "kredili devam?" sorar
TAKILMA_SESSIZ_DK=30     # bir aşama bu kadar dakika hiç ilerlemezse de sorar
